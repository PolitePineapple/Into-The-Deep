//below is for actual IMU and mapping and blah blah
public class Drivetrain {
    public DcMotor topLeftDriveMotor;
    public DcMotor bottomLeftDriveMotor;
    public DcMotor topRightDriveMotor;
    public DcMotor bottomRightDriveMotor;

    HardwareMap hwMap;

    public void init(HardwareMap ahwMap) {

        hwMap = ahwMap;

        // Control HUb motors
        rightfrontDriveMotor = hwMap.get(DcMotor.class, "rightfront");
        leftfrontDriveMotor = hwMap.get(DcMotor.class, "leftfront");
        rightbackDriveMotor = hwMap.get(DcMotor.class, "rightback");
        leftbackDriveMotor = hwMap.get(DcMotor.class, "leftback");


        /**
         * Allow the 4 wheel motors to be run without encoders since we are doing a time based autonomous
         * **/
        rightfrontDriveMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        leftfrontDriveMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        rightbackDriveMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        leftbackDriveMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);

    }

    public void power(double output){
        rightfrontDriveMotor.setPower(-output);
        leftfrontDriveMotor.setPower(-output);
        rightbackDriveMotor.setPower(output);
        leftbackDriveMotor.setPower(output);
    }
}
